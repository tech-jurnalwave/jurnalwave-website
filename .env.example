# Database PostgreSQL (Neon DB Singapore)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# Secret Key untuk Enkripsi Token JWT Sesi Admin
ADMIN_JWT_SECRET="your_super_secret_jwt_token_key_here"

# Google Gemini AI API Key (Asisten Berita JurnalWave)
GEMINI_API_KEY="your_gemini_api_key_here"

# Cloudinary CDN Storage (Upload media bukti laporan warga & berita)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# WhatsApp Gateway Fonnte (OTP Pendaftaran & Lupa Sandi Warga)
FONNTE_TOKEN="your_fonnte_token_here"

# URL Publik Website (Canonical & Sitemap)
NEXT_PUBLIC_SITE_URL="https://jurnalwave.com"

# Autentikasi Superadmin (Google SSO - Opsional)
SUPERADMIN_GOOGLE_EMAIL="tech.jurnalwave@gmail.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id_here"
